[Unit]
Description=Printer proxy (ZPL relay)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/printer-proxy/env
ExecStart=/opt/printer-proxy/current/printer-proxy
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
