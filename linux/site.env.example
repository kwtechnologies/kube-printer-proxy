# Format (systemd EnvironmentFile rules): one KEY=value per line, no quotes,
# no backslash escaping or continuation; values are taken literally.
# Per-site config. Copy to test.env / prod.env (gitignored), fill in, and keep
# the real files in the password manager only. Never commit real values.
TUNNEL_TOKEN=
API_KEY=
WIFI_SSID=
WIFI_PASSWORD=
# stable = releases/latest, pre = also v*-rc* pre-releases
CHANNEL=stable
# SSH_AUTHORIZED_KEYS: one public key, on this one line.
SSH_AUTHORIZED_KEYS=
