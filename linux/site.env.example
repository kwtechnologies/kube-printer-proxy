# Format (systemd EnvironmentFile rules): one KEY=value per line, no quotes,
# no backslash escaping or continuation; values are taken literally.
# build-image.sh rejects files that break these rules.
# Per-site config. Copy to test.env / prod.env (gitignored), fill in, and keep
# the real files in the password manager only. Never commit real values.
# Baked into the SD image as /etc/printer-proxy/env (root:root 0600).

# Required. Zero Trust > Networks > Tunnels > <tunnel> > install command: the
# long token after "--token" (or "cloudflared service install").
TUNNEL_TOKEN=
# Required. Same value as PrintProxyConfig.apiKey in kube-api-v2.
API_KEY=
# Optional Wi-Fi fallback (Ethernet is preferred). Leave both empty for
# Ethernet only. Spaces and quotes are fine, a leading/trailing space is not.
WIFI_SSID=
WIFI_PASSWORD=
# Wi-Fi regulatory country (ISO 3166 alpha-2). Default HK.
WIFI_COUNTRY=HK
# stable = releases/latest, pre = also v*-rc* pre-releases
CHANNEL=stable
# Required. Public key(s) allowed to SSH in as user kube. One key, on this line.
SSH_AUTHORIZED_KEYS=
# Optional hostname (lowercase letters, digits, dashes). Default printer-proxy.
DEVICE_HOSTNAME=
